<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FitTrack.ViewModels"
        xmlns:views="using:FitTrack.Views"
        x:Class="FitTrack.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/FitTrack-LOGO.ico"
        Title="FitTrack"
        Width="1200"
        Height="780"
        MinWidth="600"
        MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid>
        <ContentControl IsVisible="{Binding IsAuthenticationRoute}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{Binding CurrentViewModel}" />
        <views:AuthenticatedShellView IsVisible="{Binding IsAuthenticatedRoute}" />
    </Grid>

</Window>
