<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FitTrack.ViewModels"
             xmlns:models="using:FitTrack.Models"
             xmlns:shad="using:ShadUI"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:appConverters="using:FitTrack.Converters"
             xmlns:input="using:Avalonia.Input"
             x:Class="FitTrack.Views.RecordActivityView"
             x:DataType="vm:RecordActivityViewModel">

    <UserControl.Resources>
        <FontFamily x:Key="RecordActivityLucideIconFont">avares://FitTrack/Assets/Fonts#lucide</FontFamily>
        <appConverters:ActivityImageConverter x:Key="ActivityImageConverter" />

        <DataTemplate x:Key="ActivityCardItemTemplate"
                      x:DataType="models:ActivityDefinition">
                    <Border Classes="ActivityTile"
                            Margin="6"
                            ClipToBounds="True"
                            Background="{DynamicResource CardBackgroundColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource LgCornerRadius}"
                            AutomationProperties.Name="{Binding DisplayName}">
                <Grid ClipToBounds="True">
                    <Border CornerRadius="{DynamicResource LgCornerRadius}"
                            ClipToBounds="True"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch">
                        <Image Source="{Binding ActivityType, Converter={StaticResource ActivityImageConverter}}"
                               Stretch="UniformToFill" />
                    </Border>

                    <Border Classes="ActivityNameOverlay"
                            Margin="18"
                            Padding="14,8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="#66000000"
                            CornerRadius="{DynamicResource MdCornerRadius}">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Border Classes="ActivitySelectedRing"
                            Margin="3"
                            BorderBrush="{DynamicResource ForegroundColor}"
                            BorderThickness="2"
                            CornerRadius="{DynamicResource MdCornerRadius}"
                            />

                    <Border Classes="ActivitySelectedCheck"
                            Width="22"
                            Height="22"
                            Margin="8"
                            Padding="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource CardBackgroundColor}"
                            BorderBrush="{DynamicResource ForegroundColor}"
                            BorderThickness="2"
                            CornerRadius="{DynamicResource SmCornerRadius}"
                            >
                        <Viewbox Width="12"
                                 Height="12">
                            <TextBlock Classes="RecordActivityLucideIcon"
                                       Text="&#57894;"
                                       Foreground="{DynamicResource ForegroundColor}" />
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TwoColumnActivityListTemplate"
                      x:DataType="vm:RecordActivityViewModel">
            <ListBox Classes="ActivityGrid"
                     ItemsSource="{Binding AvailableActivities}"
                     SelectedItem="{Binding SelectedActivity, Mode=TwoWay}"
                     ItemTemplate="{StaticResource ActivityCardItemTemplate}"
                     IsEnabled="{Binding !IsBusy}"
                     HorizontalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Activity"
                     AutomationProperties.HelpText="Choose one of the six supported activities."
                     input:KeyboardNavigation.TabIndex="1">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </DataTemplate>

        <DataTemplate x:Key="SingleColumnActivityListTemplate"
                      x:DataType="vm:RecordActivityViewModel">
            <ListBox Classes="ActivityGrid SingleColumnActivityGrid"
                     ItemsSource="{Binding AvailableActivities}"
                     SelectedItem="{Binding SelectedActivity, Mode=TwoWay}"
                     ItemTemplate="{StaticResource ActivityCardItemTemplate}"
                     IsEnabled="{Binding !IsBusy}"
                     HorizontalAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Activity"
                     AutomationProperties.HelpText="Choose one of the six supported activities."
                     input:KeyboardNavigation.TabIndex="1">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </DataTemplate>

        <DataTemplate x:Key="ActivitySelectionTemplate"
                      x:DataType="vm:RecordActivityViewModel">
            <shad:Card Padding="22"
                       HorizontalContentAlignment="Stretch"
                       Background="{DynamicResource CardBackgroundColor}"
                       BorderBrush="{DynamicResource BorderColor}"
                       BorderThickness="1"
                       HasShadow="False">
                <shad:Card.Header>
                    <StackPanel Spacing="4">
                        <shad:CardTitle Content="Select activity"
                                        FontSize="20"
                                        TextBlock.TextWrapping="Wrap" />
                        <shad:CardDescription Content="Choose the activity you want to record today."
                                              TextBlock.TextWrapping="Wrap" />
                    </StackPanel>
                </shad:Card.Header>

                <shad:BreakpointViewPort HorizontalAlignment="Stretch">
                    <shad:BreakpointView Breakpoint="SmAndUp">
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource TwoColumnActivityListTemplate}"
                                        HorizontalContentAlignment="Stretch" />
                    </shad:BreakpointView>
                    <shad:BreakpointView Breakpoint="Sm">
                        <ContentControl Content="{Binding}"
                                        ContentTemplate="{StaticResource SingleColumnActivityListTemplate}"
                                        HorizontalContentAlignment="Stretch" />
                    </shad:BreakpointView>
                </shad:BreakpointViewPort>
            </shad:Card>
        </DataTemplate>

        <DataTemplate x:Key="EstimatedCaloriesTemplate"
                      x:DataType="vm:RecordActivityViewModel">
            <shad:Card MinHeight="112"
                       Padding="20"
                       HorizontalContentAlignment="Stretch"
                       Background="{DynamicResource CardBackgroundColor}"
                       BorderBrush="{DynamicResource BorderColor}"
                       BorderThickness="1"
                       HasShadow="False">
                <Grid ColumnDefinitions="56,*"
                      ColumnSpacing="16">
                    <Border Width="56"
                            Height="56"
                            Padding="14"
                            VerticalAlignment="Center"
                            Background="{DynamicResource SelectionColor}"
                            CornerRadius="{DynamicResource FullCornerRadius}">
                        <Viewbox Width="28"
                                 Height="28">
                            <TextBlock Classes="RecordActivityLucideIcon"
                                       Text="&#57558;"
                                       Foreground="{DynamicResource ForegroundColor}" />
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">
                        <TextBlock Text="Estimated calories"
                                   Classes="Small"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundColor}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EstimatedCalories, StringFormat='{}{0:0.00}'}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundColor}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Calculated from the selected activity metrics."
                                   Classes="Caption Muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </shad:Card>
        </DataTemplate>

        <DataTemplate x:Key="MetricsCardTemplate"
                      x:DataType="vm:RecordActivityViewModel">
            <shad:Card Padding="22"
                       HorizontalContentAlignment="Stretch"
                       Background="{DynamicResource CardBackgroundColor}"
                       BorderBrush="{DynamicResource BorderColor}"
                       BorderThickness="1"
                       HasShadow="False">
                <shad:Card.Header>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <StackPanel Spacing="5">
                            <shad:CardTitle Content="Activity metrics"
                                            FontSize="20"
                                            TextBlock.TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SelectedActivity.DisplayName}"
                                       Classes="Small"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundColor}"
                                       TextWrapping="Wrap" />
                            <shad:CardDescription Content="Enter the required measurements for the selected activity."
                                                  TextBlock.TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Clear"
                                Classes="Secondary"
                                Command="{Binding ClearFormCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                VerticalAlignment="Top"
                                AutomationProperties.Name="Clear activity form"
                                input:KeyboardNavigation.TabIndex="5" />
                    </Grid>
                </shad:Card.Header>

                <StackPanel Spacing="18">
                    <NumericUpDown Text="{Binding Metric1Input, Mode=TwoWay}"
                                   PlaceholderText="Enter value"
                                   AllowSpin="True"
                                   ShowButtonSpinner="True"
                                   HorizontalAlignment="Stretch"
                                   shad:ControlAssist.Label="{Binding Metric1Label}"
                                   shad:ControlAssist.Hint="{Binding Metric1Guidance}"
                                   IsEnabled="{Binding !IsBusy}"
                                   AutomationProperties.Name="{Binding Metric1Label}"
                                   AutomationProperties.HelpText="{Binding Metric1Guidance}"
                                   input:KeyboardNavigation.TabIndex="2">
                        <NumericUpDown.InnerRightContent>
                            <TextBlock Text="{Binding Metric1Unit}"
                                       Classes="Caption Muted"
                                       Margin="8,0" />
                        </NumericUpDown.InnerRightContent>
                    </NumericUpDown>

                    <NumericUpDown Text="{Binding Metric2Input, Mode=TwoWay}"
                                   PlaceholderText="Enter value"
                                   AllowSpin="True"
                                   ShowButtonSpinner="True"
                                   HorizontalAlignment="Stretch"
                                   shad:ControlAssist.Label="{Binding Metric2Label}"
                                   shad:ControlAssist.Hint="{Binding Metric2Guidance}"
                                   IsEnabled="{Binding !IsBusy}"
                                   AutomationProperties.Name="{Binding Metric2Label}"
                                   AutomationProperties.HelpText="{Binding Metric2Guidance}"
                                   input:KeyboardNavigation.TabIndex="3">
                        <NumericUpDown.InnerRightContent>
                            <TextBlock Text="{Binding Metric2Unit}"
                                       Classes="Caption Muted"
                                       Margin="8,0" />
                        </NumericUpDown.InnerRightContent>
                    </NumericUpDown>

                    <NumericUpDown Text="{Binding Metric3Input, Mode=TwoWay}"
                                   PlaceholderText="Enter value"
                                   AllowSpin="True"
                                   ShowButtonSpinner="True"
                                   HorizontalAlignment="Stretch"
                                   shad:ControlAssist.Label="{Binding Metric3Label}"
                                   shad:ControlAssist.Hint="{Binding Metric3Guidance}"
                                   IsEnabled="{Binding !IsBusy}"
                                   AutomationProperties.Name="{Binding Metric3Label}"
                                   AutomationProperties.HelpText="{Binding Metric3Guidance}"
                                   input:KeyboardNavigation.TabIndex="4">
                        <NumericUpDown.InnerRightContent>
                            <TextBlock Text="{Binding Metric3Unit}"
                                       Classes="Caption Muted"
                                       Margin="8,0" />
                        </NumericUpDown.InnerRightContent>
                    </NumericUpDown>

                    <Border Padding="4"
                            Background="{DynamicResource CardBackgroundColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource LgCornerRadius}">
                        <Expander IsExpanded="True"
                                  Padding="10"
                                  HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <TextBlock Text="How this activity is calculated"
                                           Classes="Small"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ForegroundColor}"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap" />
                            </Expander.Header>
                            <StackPanel Margin="4,10,4,4"
                                        Spacing="6">
                                <Border Padding="10,8"
                                        Background="{DynamicResource SecondaryColor50}"
                                        CornerRadius="{DynamicResource SmCornerRadius}">
                                    <Grid ColumnDefinitions="8,*"
                                          ColumnSpacing="8">
                                        <Border Width="4"
                                                Height="4"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource MutedColor}"
                                                CornerRadius="{DynamicResource FullCornerRadius}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="Caption Muted"
                                                   TextWrapping="Wrap">
                                            <Run Text="{Binding Metric1Label}" FontWeight="SemiBold" />
                                            <Run Text=": " />
                                            <Run Text="{Binding Metric1Usage}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Border Padding="10,8"
                                        Background="{DynamicResource SecondaryColor50}"
                                        CornerRadius="{DynamicResource SmCornerRadius}">
                                    <Grid ColumnDefinitions="8,*"
                                          ColumnSpacing="8">
                                        <Border Width="4"
                                                Height="4"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource MutedColor}"
                                                CornerRadius="{DynamicResource FullCornerRadius}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="Caption Muted"
                                                   TextWrapping="Wrap">
                                            <Run Text="{Binding Metric2Label}" FontWeight="SemiBold" />
                                            <Run Text=": " />
                                            <Run Text="{Binding Metric2Usage}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                                <Border Padding="10,8"
                                        Background="{DynamicResource SecondaryColor50}"
                                        CornerRadius="{DynamicResource SmCornerRadius}">
                                    <Grid ColumnDefinitions="8,*"
                                          ColumnSpacing="8">
                                        <Border Width="4"
                                                Height="4"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource MutedColor}"
                                                CornerRadius="{DynamicResource FullCornerRadius}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="Caption Muted"
                                                   TextWrapping="Wrap">
                                            <Run Text="{Binding Metric3Label}" FontWeight="SemiBold" />
                                            <Run Text=": " />
                                            <Run Text="{Binding Metric3Usage}" />
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border IsVisible="{Binding ErrorMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                            Padding="12"
                            Background="{DynamicResource DestructiveColor10}"
                            BorderBrush="{DynamicResource DestructiveColor50}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource LgCornerRadius}">
                        <Grid ColumnDefinitions="16,*"
                              ColumnSpacing="8">
                            <Viewbox Width="16"
                                     Height="16">
                                <TextBlock Classes="RecordActivityLucideIcon"
                                           Text="&#57467;"
                                           Foreground="{DynamicResource DestructiveColor}" />
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ErrorMessage}"
                                       Classes="Small Error"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}"
                            Padding="12"
                            Background="{DynamicResource SelectionColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource LgCornerRadius}">
                        <Grid ColumnDefinitions="16,*"
                              ColumnSpacing="8">
                            <Viewbox Width="16"
                                     Height="16">
                                <TextBlock Classes="RecordActivityLucideIcon"
                                           Text="&#57894;"
                                           Foreground="{DynamicResource ForegroundColor}" />
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StatusMessage}"
                                       Classes="Small"
                                       Foreground="{DynamicResource ForegroundColor}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <Border IsVisible="{Binding IsBusy}"
                            Padding="12"
                            Background="{DynamicResource SelectionColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource LgCornerRadius}">
                        <Grid ColumnDefinitions="16,*"
                              ColumnSpacing="8">
                            <Viewbox Width="16"
                                     Height="16">
                                <TextBlock Classes="RecordActivityLucideIcon"
                                           Text="&#57614;"
                                           Foreground="{DynamicResource ForegroundColor}" />
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="Recording your activity..."
                                       Classes="Small Muted"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </StackPanel>

                <shad:Card.Footer>
                    <StackPanel Spacing="12">
                        <Button Content="Record Activity"
                                Classes="Primary"
                                Command="{Binding RecordActivityCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                shad:ButtonAssist.ShowProgress="{Binding IsBusy}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                AutomationProperties.Name="Record activity"
                                input:KeyboardNavigation.TabIndex="6" />
                        <Border Padding="11"
                                Background="{DynamicResource SecondaryColor50}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource LgCornerRadius}">
                            <Grid ColumnDefinitions="16,*"
                                  ColumnSpacing="8">
                                <Viewbox Width="16"
                                         Height="16">
                                    <TextBlock Classes="RecordActivityLucideIcon"
                                               Text="&#57599;"
                                               Foreground="{DynamicResource MutedColor}" />
                                </Viewbox>
                                <TextBlock Grid.Column="1"
                                           Text="Enter the required measurements for the selected activity."
                                           Classes="Caption Muted"
                                           TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </shad:Card.Footer>
            </shad:Card>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock.RecordActivityLucideIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="FontFamily" Value="{StaticResource RecordActivityLucideIconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="ExtraLight" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="ListBox.ActivityGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="-6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.ActivityGrid ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.ActivityGrid ListBoxItem Border.ActivityTile">
            <Setter Property="Height" Value="142" />
        </Style>
        <Style Selector="ListBox.SingleColumnActivityGrid ListBoxItem Border.ActivityTile">
            <Setter Property="Height" Value="230" />
        </Style>
        <Style Selector="ListBox.ActivityGrid ListBoxItem Border.ActivityNameOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.ActivityGrid ListBoxItem Border.ActivitySelectedRing">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.ActivityGrid ListBoxItem Border.ActivitySelectedCheck">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.ActivityGrid ListBoxItem:pointerover Border.ActivityTile">
            <Setter Property="BorderBrush" Value="{DynamicResource MutedColor}" />
        </Style>
        <Style Selector="ListBox.ActivityGrid ListBoxItem:selected Border.ActivitySelectedRing">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ListBox.ActivityGrid ListBoxItem:selected Border.ActivitySelectedCheck">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="ListBox.ActivityGrid ListBoxItem /template/ PathIcon#CheckSelected">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="ListBox.ActivityGrid ListBoxItem /template/ Border#SelectionBackground">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBox.ActivityGrid ListBoxItem /template/ Border#HoverBackground">
            <Setter Property="Opacity" Value="0" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Top">
        <Grid ColumnDefinitions="*,12">
            <StackPanel Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Spacing="20">
                <shad:BreakpointViewPort HorizontalAlignment="Stretch">
                    <shad:BreakpointView Breakpoint="LgAndUp">
                        <Grid ColumnDefinitions="2*,*"
                              ColumnSpacing="20">
                            <StackPanel VerticalAlignment="Center"
                                        Spacing="6">
                                <TextBlock Text="Record today activity"
                                           Classes="h2"
                                           Foreground="{DynamicResource ForegroundColor}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Choose an activity and enter the required measurements."
                                           Classes="Muted"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ContentControl Grid.Column="1"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource EstimatedCaloriesTemplate}"
                                            HorizontalContentAlignment="Stretch" />
                        </Grid>
                    </shad:BreakpointView>

                    <shad:BreakpointView Breakpoint="LgAndDown">
                        <StackPanel Spacing="16">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Record today activity"
                                           Classes="h2"
                                           Foreground="{DynamicResource ForegroundColor}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Choose an activity and enter the required measurements."
                                           Classes="Muted"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource EstimatedCaloriesTemplate}"
                                            HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </shad:BreakpointView>
                </shad:BreakpointViewPort>

                <shad:BreakpointViewPort HorizontalAlignment="Stretch">
                    <shad:BreakpointView Breakpoint="LgAndUp">
                        <Grid ColumnDefinitions="2*,*"
                              ColumnSpacing="20">
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource ActivitySelectionTemplate}"
                                            HorizontalContentAlignment="Stretch" />
                            <ContentControl Grid.Column="1"
                                            Content="{Binding}"
                                            ContentTemplate="{StaticResource MetricsCardTemplate}"
                                            HorizontalContentAlignment="Stretch" />
                        </Grid>
                    </shad:BreakpointView>

                    <shad:BreakpointView Breakpoint="LgAndDown">
                        <StackPanel Spacing="20">
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource ActivitySelectionTemplate}"
                                            HorizontalContentAlignment="Stretch" />
                            <ContentControl Content="{Binding}"
                                            ContentTemplate="{StaticResource MetricsCardTemplate}"
                                            HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </shad:BreakpointView>
                </shad:BreakpointViewPort>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
