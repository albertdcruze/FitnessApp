<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FitnessApp.ViewModels"
             xmlns:shad="using:ShadUI"
             x:Class="FitnessApp.Views.GoalView"
             x:DataType="vm:GoalViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24"
                    Spacing="16">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
                <StackPanel Spacing="4">
                    <TextBlock Text="Set Daily Goal"
                               FontSize="26"
                               FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="4">
                        <TextBlock Text="Signed in as"
                                   FontSize="16" />
                        <TextBlock Text="{Binding Username}"
                                   FontSize="16" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Log out"
                        Classes="secondary"
                        Command="{Binding LogoutCommand}"
                        IsEnabled="{Binding !IsBusy}" />
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="IndianRed"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="ForestGreen"
                       TextWrapping="Wrap" />
            <TextBlock Text="Loading your goal..."
                       IsVisible="{Binding IsBusy}" />

            <shad:Card HasShadow="True"
                       IsVisible="{Binding ShowExistingGoal}">
                <StackPanel Margin="16"
                            Spacing="6">
                    <TextBlock Text="Current daily target"
                               FontWeight="Bold" />
                    <TextBlock Text="{Binding ExistingTargetCalories, StringFormat='{}{0:0.##} estimated calories'}"
                               FontSize="22" />
                </StackPanel>
            </shad:Card>

            <shad:Card HasShadow="True"
                       IsVisible="{Binding ShowNoGoalPrompt}">
                <TextBlock Margin="16"
                           Text="You have not set a daily calorie goal yet."
                           TextWrapping="Wrap" />
            </shad:Card>

            <shad:Card HasShadow="True">
                <StackPanel Margin="16"
                            Spacing="10">
                    <TextBlock Text="Daily calorie goal"
                               FontWeight="Bold" />
                    <TextBox PlaceholderText="Enter calories"
                             Text="{Binding GoalInput, Mode=TwoWay}" />
                    <TextBlock Text="Enter a whole number from 1 to 5,000 estimated calories."
                               TextWrapping="Wrap" />
                    <Button Content="Save Goal"
                            Classes="primary"
                            Command="{Binding SaveGoalCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
            </shad:Card>

            <Button Content="Back to Dashboard"
                    Classes="secondary"
                    Command="{Binding BackToDashboardCommand}"
                    IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
