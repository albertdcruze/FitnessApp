<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FitnessApp.ViewModels"
             xmlns:shad="using:ShadUI"
             xmlns:input="using:Avalonia.Input"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="FitnessApp.Views.GoalView"
             x:DataType="vm:GoalViewModel">

    <ScrollViewer MaxWidth="720"
                  HorizontalAlignment="Center"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24"
                    Spacing="18">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="Set Daily Goal"
                               Classes="page-title" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <TextBlock Text="Signed in as"
                                   Classes="muted" />
                        <TextBlock Text="{Binding Username}"
                                   Classes="muted" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Log out"
                        Classes="secondary"
                        Command="{Binding LogoutCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        input:KeyboardNavigation.TabIndex="90" />
            </Grid>

            <Border Classes="message-error"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Classes="message-error"
                           TextWrapping="Wrap" />
            </Border>
            <Border Classes="message-info"
                    IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Classes="message-info"
                           TextWrapping="Wrap" />
            </Border>
            <Border Classes="message-info"
                    IsVisible="{Binding IsBusy}">
                <TextBlock Text="Loading your goal..."
                           Classes="message-info"
                           TextWrapping="Wrap" />
            </Border>

            <shad:Card HasShadow="False"
                       IsVisible="{Binding ShowExistingGoal}">
                <StackPanel Margin="20"
                            Spacing="8">
                    <TextBlock Text="Current daily target"
                               Classes="section-title" />
                    <TextBlock Text="{Binding ExistingTargetCalories, StringFormat='{}{0:0.##} estimated calories'}"
                               Classes="value" />
                </StackPanel>
            </shad:Card>

            <shad:Card HasShadow="False"
                       IsVisible="{Binding ShowNoGoalPrompt}">
                <StackPanel Margin="20"
                            Spacing="8">
                    <TextBlock Text="No daily goal yet"
                               Classes="section-title" />
                    <TextBlock Text="Set a target to compare your daily estimated calories with a goal."
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
            </shad:Card>

            <shad:Card HasShadow="False">
                <StackPanel Margin="20"
                            Spacing="12">
                    <TextBlock Text="Daily calorie goal"
                               Classes="section-title" />
                    <TextBlock Text="Enter an estimated daily target using a whole number from 1 to 5,000."
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Goal calories"
                               Classes="field-label" />
                    <TextBox Text="{Binding GoalInput, Mode=TwoWay}"
                             AutomationProperties.Name="Goal calories"
                             AutomationProperties.HelpText="Enter a whole number from 1 to 5,000 estimated calories." />
                    <TextBlock Text="1–5,000 estimated calories. Whole numbers only."
                               Classes="muted"
                               TextWrapping="Wrap" />
                    <Button Content="Save Goal"
                            Classes="primary"
                            IsDefault="True"
                            Command="{Binding SaveGoalCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </shad:Card>

            <Button Content="Back to Dashboard"
                    Classes="secondary"
                    Command="{Binding BackToDashboardCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
