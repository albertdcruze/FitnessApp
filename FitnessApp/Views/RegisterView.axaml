<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FitnessApp.ViewModels"
             xmlns:shad="using:ShadUI"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="FitnessApp.Views.RegisterView"
             x:DataType="vm:RegisterViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Center">
        <Grid Margin="24"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Center">
            <shad:Card MaxWidth="480"
                       HorizontalAlignment="Center"
                       HasShadow="False">
                <StackPanel MinWidth="280"
                            MaxWidth="420"
                            Margin="28"
                            HorizontalAlignment="Stretch"
                            Spacing="14">
                <TextBlock Text="FitnessApp"
                           Classes="section-title" />
                <TextBlock Text="Create an account"
                           Classes="page-title" />
                <TextBlock Text="Set up an account to track your daily fitness progress."
                           Classes="muted"
                           TextWrapping="Wrap" />

                <TextBlock Text="Username"
                           Classes="field-label" />
                <TextBox Text="{Binding Username, Mode=TwoWay}"
                         AutomationProperties.Name="Username"
                         AutomationProperties.HelpText="1 to 30 characters; letters and numbers only." />
                <TextBlock Text="1–30 characters. Letters and numbers only."
                           Classes="muted"
                           TextWrapping="Wrap" />

                <TextBlock Text="Password"
                           Classes="field-label" />
                <TextBox PasswordChar="*"
                         Text="{Binding Password, Mode=TwoWay}"
                         AutomationProperties.Name="Password"
                         AutomationProperties.HelpText="Exactly 12 characters with at least one uppercase and one lowercase letter." />
                <TextBlock Text="Exactly 12 characters. Include at least one uppercase letter and one lowercase letter."
                           Classes="muted"
                           TextWrapping="Wrap" />

                <Border Classes="message-error"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Classes="message-error"
                               TextWrapping="Wrap" />
                </Border>
                <Border Classes="message-success"
                        IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Classes="message-success"
                               TextWrapping="Wrap" />
                </Border>

                <Button Content="Register"
                        Classes="primary"
                        IsDefault="True"
                        Command="{Binding RegisterCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        HorizontalAlignment="Stretch" />
                <Button Content="Back to sign in"
                        Classes="secondary"
                        Command="{Binding BackToLoginCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        HorizontalAlignment="Stretch" />

                <TextBlock Text="Creating your account..."
                           Classes="muted"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding IsBusy}" />
                </StackPanel>
            </shad:Card>
        </Grid>
    </ScrollViewer>
</UserControl>
