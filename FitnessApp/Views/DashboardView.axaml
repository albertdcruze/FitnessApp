<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FitnessApp.ViewModels"
             xmlns:shad="using:ShadUI"
             xmlns:input="using:Avalonia.Input"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="FitnessApp.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer MaxWidth="1080"
                  HorizontalAlignment="Center"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24"
                    Spacing="20">
            <Grid ColumnDefinitions="*,Auto,Auto"
                  ColumnSpacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="Dashboard"
                               Classes="page-title" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <TextBlock Text="Welcome,"
                                   Classes="muted" />
                        <TextBlock Text="{Binding Username}"
                                   Classes="muted" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Classes="secondary"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        input:KeyboardNavigation.TabIndex="80" />
                <Button Grid.Column="2"
                        Content="Log out"
                        Classes="secondary"
                        Command="{Binding LogoutCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        input:KeyboardNavigation.TabIndex="90" />
            </Grid>

            <Border Classes="message-error"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Classes="message-error"
                           TextWrapping="Wrap" />
            </Border>
            <Border Classes="message-info"
                    IsVisible="{Binding NavigationMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding NavigationMessage}"
                           Classes="message-info"
                           TextWrapping="Wrap" />
            </Border>
            <Border Classes="message-info"
                    IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Classes="message-info"
                           TextWrapping="Wrap" />
            </Border>
            <Border Classes="message-info"
                    IsVisible="{Binding IsBusy}">
                <TextBlock Text="Loading your progress..."
                           Classes="message-info"
                           TextWrapping="Wrap" />
            </Border>

            <WrapPanel Orientation="Horizontal"
                       ItemWidth="320"
                       ItemSpacing="12"
                       LineSpacing="12">
                <shad:Card Width="320"
                           HasShadow="False">
                    <StackPanel Margin="20"
                                Spacing="6">
                        <TextBlock Text="Estimated calories burned today"
                                   Classes="value-label"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TotalCalories, StringFormat='{}{0:0.##} estimated calories'}"
                                   Classes="value" />
                    </StackPanel>
                </shad:Card>
                <shad:Card Width="320"
                           HasShadow="False"
                           IsVisible="{Binding HasGoal}">
                    <StackPanel Margin="20"
                                Spacing="6">
                        <TextBlock Text="Daily target"
                                   Classes="value-label" />
                        <TextBlock Text="{Binding TargetCalories, StringFormat='{}{0:0.##} estimated calories'}"
                                   Classes="value" />
                    </StackPanel>
                </shad:Card>
                <shad:Card Width="320"
                           HasShadow="False"
                           IsVisible="{Binding HasGoal}">
                    <StackPanel Margin="20"
                                Spacing="6">
                        <TextBlock Text="Remaining today"
                                   Classes="value-label" />
                        <TextBlock Text="{Binding RemainingCalories, StringFormat='{}{0:0.##} estimated calories'}"
                                   Classes="value" />
                    </StackPanel>
                </shad:Card>
            </WrapPanel>

            <shad:Card HasShadow="False"
                       IsVisible="{Binding ShowGoalProgress}">
                <StackPanel Margin="20"
                            Spacing="12">
                    <TextBlock Text="Today’s progress"
                               Classes="section-title" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <TextBlock Text="Progress"
                                   Classes="field-label" />
                        <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0.##}%'}"
                                   Classes="value-label" />
                    </StackPanel>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Height="12"
                                 Value="{Binding ProgressBarValue}"
                                 AutomationProperties.Name="Today’s progress"
                                 AutomationProperties.HelpText="The bar is visually capped at 100 percent while the numeric percentage remains exact." />
                </StackPanel>
            </shad:Card>

            <shad:Card HasShadow="False"
                       IsVisible="{Binding ShowNoGoalPrompt}">
                <StackPanel Margin="20"
                            Spacing="8">
                    <TextBlock Text="No daily goal yet"
                               Classes="section-title" />
                    <TextBlock Text="Set a daily calorie goal to track your progress against a target."
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
            </shad:Card>

            <WrapPanel Orientation="Horizontal"
                       ItemSpacing="10"
                       LineSpacing="10">
                <Button Content="Record Activity"
                        Classes="primary"
                        Command="{Binding NavigateToRecordActivityCommand}"
                        IsEnabled="{Binding !IsBusy}" />
                <Button Content="Set Goal"
                        Classes="secondary"
                        Command="{Binding NavigateToGoalCommand}"
                        IsEnabled="{Binding !IsBusy}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
