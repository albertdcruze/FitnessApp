<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FitnessApp.ViewModels"
        xmlns:shad="using:ShadUI"
        x:Class="FitnessApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="FitnessApp"
        Width="800"
        Height="520">

    <Grid Margin="24">
        <shad:Card HasShadow="True">
            <ContentControl Margin="24"
                            Content="{Binding CurrentViewModel}" />
        </shad:Card>
    </Grid>

</Window>
