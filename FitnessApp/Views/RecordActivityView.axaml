<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FitnessApp.ViewModels"
             xmlns:models="using:FitnessApp.Models"
             xmlns:shad="using:ShadUI"
             xmlns:input="using:Avalonia.Input"
             xmlns:converters="using:Avalonia.Data.Converters"
             x:Class="FitnessApp.Views.RecordActivityView"
             x:DataType="vm:RecordActivityViewModel">

    <ScrollViewer MaxWidth="920"
                  HorizontalAlignment="Center"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24"
                    Spacing="18">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="Record Activity"
                               Classes="page-title" />
                    <StackPanel Orientation="Horizontal"
                                Spacing="6">
                        <TextBlock Text="Signed in as"
                                   Classes="muted" />
                        <TextBlock Text="{Binding Username}"
                                   Classes="muted" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Log out"
                        Classes="secondary"
                        Command="{Binding LogoutCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        input:KeyboardNavigation.TabIndex="90" />
            </Grid>

            <Border Classes="message-error"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Classes="message-error"
                           TextWrapping="Wrap" />
            </Border>
            <Border Classes="message-success"
                    IsVisible="{Binding StatusMessage, Converter={x:Static converters:StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Classes="message-success"
                           TextWrapping="Wrap" />
            </Border>
            <Border Classes="message-info"
                    IsVisible="{Binding IsBusy}">
                <TextBlock Text="Recording your activity..."
                           Classes="message-info"
                           TextWrapping="Wrap" />
            </Border>

            <shad:Card HasShadow="False">
                <StackPanel Margin="20"
                            Spacing="10">
                    <TextBlock Text="Choose an activity"
                               Classes="section-title" />
                    <TextBlock Text="Activity"
                               Classes="field-label" />
                    <ComboBox ItemsSource="{Binding AvailableActivities}"
                              SelectedItem="{Binding SelectedActivity, Mode=TwoWay}"
                              IsEnabled="{Binding !IsBusy}"
                              AutomationProperties.Name="Activity"
                              AutomationProperties.HelpText="Choose one of the six supported activities.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ActivityDefinition">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </shad:Card>

            <shad:Card HasShadow="False">
                <StackPanel Margin="20"
                            Spacing="14">
                    <TextBlock Text="Activity metrics"
                               Classes="section-title" />

                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <TextBlock Text="{Binding Metric1Label}"
                                       Classes="field-label" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Metric1Unit}"
                                       Classes="muted" />
                        </Grid>
                        <TextBox Text="{Binding Metric1Input, Mode=TwoWay}"
                                 IsEnabled="{Binding !IsBusy}"
                                 AutomationProperties.Name="{Binding Metric1Label}"
                                 AutomationProperties.HelpText="{Binding Metric1Guidance}" />
                        <TextBlock Text="{Binding Metric1Guidance}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <TextBlock Text="{Binding Metric2Label}"
                                       Classes="field-label" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Metric2Unit}"
                                       Classes="muted" />
                        </Grid>
                        <TextBox Text="{Binding Metric2Input, Mode=TwoWay}"
                                 IsEnabled="{Binding !IsBusy}"
                                 AutomationProperties.Name="{Binding Metric2Label}"
                                 AutomationProperties.HelpText="{Binding Metric2Guidance}" />
                        <TextBlock Text="{Binding Metric2Guidance}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <TextBlock Text="{Binding Metric3Label}"
                                       Classes="field-label" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Metric3Unit}"
                                       Classes="muted" />
                        </Grid>
                        <TextBox Text="{Binding Metric3Input, Mode=TwoWay}"
                                 IsEnabled="{Binding !IsBusy}"
                                 AutomationProperties.Name="{Binding Metric3Label}"
                                 AutomationProperties.HelpText="{Binding Metric3Guidance}" />
                        <TextBlock Text="{Binding Metric3Guidance}"
                                   Classes="muted"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Content="Record Activity"
                            Classes="primary"
                            Command="{Binding RecordActivityCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </shad:Card>

            <shad:Card HasShadow="False"
                       IsVisible="{Binding HasResult}">
                <StackPanel Margin="20"
                            Spacing="6">
                    <TextBlock Text="Estimated calories"
                               Classes="section-title" />
                    <TextBlock Text="{Binding EstimatedCalories, StringFormat='{}{0:0.##}'}"
                               Classes="value" />
                    <TextBlock Text="Estimated from the recorded activity metrics."
                               Classes="muted"
                               TextWrapping="Wrap" />
                </StackPanel>
            </shad:Card>

            <WrapPanel Orientation="Horizontal"
                       ItemSpacing="10"
                       LineSpacing="10">
                <Button Content="Clear Form"
                        Classes="secondary"
                        Command="{Binding ClearFormCommand}"
                        IsEnabled="{Binding !IsBusy}" />
                <Button Content="Back to Dashboard"
                        Classes="secondary"
                        Command="{Binding BackToDashboardCommand}"
                        IsEnabled="{Binding !IsBusy}" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
